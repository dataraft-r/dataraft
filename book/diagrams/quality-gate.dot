digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad=0.25, nodesep=0.35, ranksep=0.6, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#183153", fontcolor="#20252B", fontname="Arial", fontsize=10, margin="0.16,0.10"];
  edge [color="#52606D", penwidth=1.3, arrowsize=0.7, fontname="Arial", fontsize=9];
  candidate [label="Prepared candidate"];
  contract [label="Contract checks\ncolumns, types, keys, constraints"];
  quality [label="Quality rules\nbusiness predicates"];
  action [shape=diamond, label="Decision", fillcolor="#E7F2F2", color="#2A7F7F"];
  block [label="Block\nkeep diagnostics", fillcolor="#FBEAEA", color="#A33A3A"];
  warn [label="Warn\naccept with evidence", fillcolor="#FFF4E5", color="#A46500"];
  quarantine [label="Quarantine\nremove failing rows", fillcolor="#FFF4E5", color="#A46500"];
  accept [label="Accepted candidate", fillcolor="#E7F2F2", color="#2A7F7F"];
  candidate -> contract -> quality -> action;
  action -> block [label="block"];
  action -> warn [label="warn"];
  action -> quarantine [label="quarantine"];
  action -> accept [label="pass"];
  warn -> accept;
  quarantine -> accept;
}
