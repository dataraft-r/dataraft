digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad=0.25, nodesep=0.35, ranksep=0.55, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#183153", fontcolor="#20252B", fontname="Arial", fontsize=11, margin="0.16,0.10"];
  edge [color="#52606D", penwidth=1.4, arrowsize=0.7, fontname="Arial", fontsize=9, fontcolor="#52606D"];
  source [label="Source data"];
  def [label="Product definition", fillcolor="#E8EEF6"];
  prep [label="Preparation"];
  gate [label="Contract + quality gate", fillcolor="#E7F2F2", color="#2A7F7F"];
  diag [label="Diagnostics", fillcolor="#FFF4E5", color="#A46500"];
  checked [label="Checked result", fillcolor="#E7F2F2", color="#2A7F7F"];
  collect [label="Collect in R"];
  publish [label="Publish"];
  physical [label="RDS / DB / Parquet / pins\nDuckDB / DuckLake"];
  evidence [label="Evidence + lineage", fillcolor="#EEF2F7"];
  source -> def -> prep -> gate;
  gate -> diag [label="blocked"];
  gate -> checked [label="accepted"];
  checked -> collect;
  checked -> publish -> physical;
  checked -> evidence;
  publish -> evidence;
}
