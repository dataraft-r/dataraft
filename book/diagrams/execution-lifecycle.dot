digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad=0.25, nodesep=0.3, ranksep=0.55, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#183153", fontcolor="#20252B", fontname="Arial", fontsize=10, margin="0.14,0.09"];
  edge [color="#52606D", penwidth=1.3, arrowsize=0.7, fontname="Arial", fontsize=9];
  defined [label="defined"];
  validated [label="validated"];
  planned [label="planned"];
  running [label="running"];
  completed [label="completed", fillcolor="#E7F2F2", color="#2A7F7F"];
  published [label="published", fillcolor="#E7F2F2", color="#2A7F7F"];
  cached [label="cached", fillcolor="#E7F2F2", color="#2A7F7F"];
  blocked [label="blocked", fillcolor="#FBEAEA", color="#A33A3A"];
  error [label="error", fillcolor="#FBEAEA", color="#A33A3A"];
  missing [label="missing", fillcolor="#FBEAEA", color="#A33A3A"];
  defined -> validated -> planned -> running;
  running -> completed;
  running -> published;
  running -> cached;
  running -> blocked;
  running -> error;
  running -> missing;
}
