digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad=0.25, nodesep=0.35, ranksep=0.45, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#183153", fontcolor="#20252B", fontname="Arial", fontsize=10, margin="0.16,0.10"];
  edge [color="#52606D", penwidth=1.2, arrowsize=0.7];
  product [label="Product lineage\nwhich product depends on which?"];
  column [label="Static column lineage\nwhich input columns feed an output?"];
  backend [label="Backend lineage\nwhat did an external engine report?"];
  business [label="Business lineage\nwhat definition and release explain this number?"];
  evidence [label="Evidence boundary\nknown / unknown / incomplete", fillcolor="#E7F2F2", color="#2A7F7F"];
  product -> evidence;
  column -> evidence;
  backend -> evidence;
  business -> evidence;
}
